{
  "name": "spotube-jam-server",
  "version": "1.0.0",
  "private": true,
  "description": "Room server for Spotube's Group Jam: a Cloudflare Worker with one Durable Object per room code that keeps listeners' playback in sync.",
  "keywords": [
    "spotube",
    "jam",
    "listen-together",
    "cloudflare-workers",
    "durable-objects",
    "websocket"
  ],
  "homepage": "https://github.com/team-spotube/jam-server#readme",
  "bugs": {
    "url": "https://github.com/team-spotube/jam-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-spotube/jam-server.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kingkor Roy Tirtho and Spotube Contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node test/smoke.mjs",
    "go:run": "JAM_DB=${JAM_DB:-$PWD/.data/jam.db} go -C src-go run .",
    "go:build": "go -C src-go build -trimpath -o ../bin/spotube-jamd .",
    "go:test": "go -C src-go test ./...",
    "go:lint": "go -C src-go vet ./... && test -z \"$(gofmt -l src-go)\"",
    "go:fmt": "gofmt -w src-go",
    "go:docker": "docker build -t spotube-jamd src-go",
    "license:check": "node scripts/license-header.mjs --check",
    "license:fix": "node scripts/license-header.mjs --fix",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@11.25.0"
}
